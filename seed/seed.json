 "content": {
  "home_page": [
   {
    "id": "home",
    "slug": "home",
    "status": "published",
    "data": {
     "title": "Home page",
     "eyebrow": "Thai tarot · Thai astrology",
     "headline": "Thai tarot and astrology, read together and explained clearly.",
     "lead": "I'm Hope, a web developer who reads Thai tarot, known in Thailand as Promayarn cards (ไพ่พรหมญาณ), and Thai astrology. In a consultation I use both, and I show you what each one says and why, so you can decide for yourself.",
     "primary_button": "Book a consultation",
     "secondary_link": "How a consultation works",
     "points": [
      {
       "title": "I show the reasoning",
       "text": "Every interpretation says what it is based on, so you can follow it and disagree with it."
      },
      {
       "title": "No fear, no theatre",
       "text": "A consultation is for reflection and decisions. It is not a prediction of doom."
      },
      {
       "title": "Built, not just written",
       "text": "Where a tool explains something better than an article, I build the tool."
      }
     ],
     "posts_eyebrow": "Start here",
     "posts_title": "Understand how it works before you trust it",
     "astro_eyebrow": "Thai astrology",
     "astro_title": "Two practices, one consultation",
     "astro_text": "The cards and the chart are separate practices that share the same signs and planets. In a consultation I read both side by side and explain each one piece by piece, starting with your sign.",
     "astro_button": "Start with your sign",
     "astro_note": "Feng shui and bazi are part of the practice too, and will follow.",
     "consult_eyebrow": "Consultations",
     "consult_title": "Bring one question, or ten",
     "consult_text": "A consultation combines Thai tarot and Thai astrology. Mostly by voice call, in English or Thai, with unlimited questions in the time.",
     "thai_link": "ลูกค้าไทย ดูราคาเป็นบาทและจองผ่าน LINE",
     "about_eyebrow": "About",
     "about_title": "Why a developer reads cards",
     "about_lead": "I build websites for a living and read Thai tarot and Thai astrology for the people who ask. Both jobs come down to the same thing: taking a system apart until it makes sense.",
     "about_body": "[Two or three sentences in your own words: the travelling, the spiritual path, and how they led to the practice.]",
     "about_link": "Read my story"
    }
   }
  ],
  "consult_page": [
   {
    "id": "consultations",
    "slug": "consultations",
    "status": "published",
    "data": {
     "title": "Consultations page",
     "eyebrow": "Consultations",
     "headline": "A consultation you can follow",
     "lead": "Each consultation combines Thai tarot, known as Promayarn cards (ไพ่พรหมญาณ), and Thai astrology. Mostly by voice call, with no video, in English or Thai. You ask as many questions as fit in the time, and I explain what the cards and your chart say, and why.",
     "thai_note": "สำหรับลูกค้าไทย: 30 นาที 1,500 บาท · 1 ชั่วโมง 2,000 บาท · ถามได้ไม่จำกัด",
     "thai_link": "จองคิวผ่าน LINE",
     "steps_title": "How it works",
     "steps": [
      {
       "title": "Message me",
       "text": "WhatsApp for Singapore, Malaysia and everywhere else, LINE for Thailand. Tell me which session you want, and your date, time and place of birth for the chart."
      },
      {
       "title": "Pick a time and pay",
       "text": "You get a link to choose a slot. Payment is by [PAYMENT METHOD] and confirms the booking."
      },
      {
       "title": "We talk by voice call",
       "text": "A voice call with no video, at the time you chose: on LINE in Thailand, and on WhatsApp everywhere else. Bring your questions; a notebook helps."
      }
     ],
     "get_title": "What you get",
     "get_list": [
      {
       "text": "What each card or chart position suggests, and what that is based on."
      },
      {
       "text": "Plain words. Every term is explained the first time it comes up."
      },
      {
       "text": "Time to push back, ask again, and look at the question another way."
      }
     ],
     "not_title": "What it is not",
     "not_list": [
      {
       "text": "A prediction. I will not tell you what is going to happen."
      },
      {
       "text": "A warning meant to frighten you into coming back."
      },
      {
       "text": "A substitute for medical, legal or financial advice."
      }
     ],
     "book_title": "Book a consultation",
     "book_text": "Messaging is the quickest way to book.",
     "whatsapp_label": "Singapore, Malaysia and international · English",
     "whatsapp_number": "[YOUR WHATSAPP NUMBER]",
     "whatsapp_url": "https://wa.me/",
     "whatsapp_button": "Message on WhatsApp",
