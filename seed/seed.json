  "posts": [
   {
    "id": "post-69",
    "slug": "thai-tarot-is-not-quite-tarot",
    "status": "published",
    "taxonomies": {
     "category": [
      "understand"
     ],
     "tag": [
      "thai-tarot"
     ]
    },
    "data": {
     "title": "Thai tarot is not quite tarot: the 69 Promayarn cards",
     "featured": true,
     "excerpt": "People call it Thai tarot because that is the easiest way to explain it. The deck itself is different: 69 cards in five groups, built on Thai astrology.",
     "content": [
      {
       "_type": "block",
       "_key": "k009",
       "style": "normal",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "_key": "k010",
         "text": "[Draft from published descriptions of the deck. Check every detail against your own practice before publishing.]",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "_key": "k011",
       "style": "normal",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "_key": "k012",
         "text": "If you know Western tarot, you expect 78 cards, a Fool and a Tower. Promayarn cards (ไพ่พรหมญาณ) have none of those. The deck has 69 cards, and it is drawn from Thai astrology and Thai literature.",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "_key": "k013",
       "style": "h2",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "_key": "k014",
         "text": "The five groups",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "_key": "k015",
       "style": "normal",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "_key": "k016",
         "text": "2 teacher cards, which are set aside and not used in a reading.",
         "marks": []
        }
       ],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k017",
       "style": "normal",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "_key": "k018",
         "text": "7 day cards, one for each day of birth and its planet.",
         "marks": []
        }
       ],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k019",
       "style": "normal",
       "markDefs": [],
       "children": [
        {
