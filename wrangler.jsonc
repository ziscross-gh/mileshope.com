{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The Worker name. It must match the Worker's name in the Cloudflare dashboard.
	"name": "mileshope-com",
	// www.mileshope.com is attached to this Worker in the Cloudflare dashboard
	// (Settings, Domains & Routes), so no routes are listed here and Wrangler
	// leaves the domain alone. The workers.dev address stays switched off.
	"workers_dev": false,
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mileshope",
			"database_id": "2a039a9e-636f-4c61-ae92-b1791ff4b1da",
		},
	],
	// Uploaded images and files (Standard storage, Asia-Pacific).
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mileshope-media",
		},
	],
	// Logs and traces in the Cloudflare dashboard, for finding errors and
	// slow requests after a deploy.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 },
	},
	// Runs scheduled publishing and maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
}
