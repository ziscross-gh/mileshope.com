---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="wrap section stack">
		<p class="label">404</p>
		<h1>That page isn't here</h1>
		<p class="lead measure">The link may be old, or the page may have moved.</p>
		<p><a class="btn btn-earth" href="/">Back to the home page</a></p>
	</section>
</Base>
