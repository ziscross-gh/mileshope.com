---
import { getEmDashEntry, getSeoMeta, decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const section = (post.data.terms?.category ?? [])[0];
const published = post.data.publishedAt?.toLocaleDateString("en-GB", {
	year: "numeric",
	month: "short",
	day: "2-digit",
});
---

<Base
	title={seo.title}
	kind={section?.label ?? "Articles"}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="wrap section stack" style="gap: var(--space-6)">
		<header class="stack measure-wide">
			<p class="label">
				{section && <a class="plain" href={`/category/${section.slug}`}>{section.label}</a>}
				{section && published && " · "}
				{published && <time datetime={post.data.publishedAt!.toISOString()}>{published}</time>}
			</p>
			<h1 {...post.edit.title}>{post.data.title}</h1>
			{post.data.excerpt && <p class="lead" {...post.edit.excerpt}>{post.data.excerpt}</p>}
		</header>

		{
			post.data.featured_image && (
				<div class="cover" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="prose" {...post.edit.content}>
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<p class="label tags">
					{tags.map((t) => (
						<a class="plain" href={`/tag/${t.slug}`}>
							{t.label}
						</a>
					))}
				</p>
			)
		}

		<aside class="card next">
			<div class="stack-sm">
				<h2 class="h3">Want this applied to your own question?</h2>
				<p>A consultation combines Thai tarot and Thai astrology, by voice call.</p>
			</div>
			<a class="btn btn-book" href="/consultations">Book a consultation</a>
		</aside>
	</article>
</Base>

<style>
	.measure-wide {
		max-width: 760px;
	}
	.plain {
		color: inherit;
		text-decoration: none;
	}
	.plain:hover {
		text-decoration: underline;
	}
	.cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
	.next {
		max-width: 760px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-6);
	}
</style>
