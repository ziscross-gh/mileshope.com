---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// One batched query for the Section of every post.
const sections = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);
---

<Base title="All articles">
	<section class="wrap section stack" style="gap: var(--space-6)">
		<div class="stack-sm">
			<p class="label">Articles</p>
			<h1>Everything written so far</h1>
		</div>
		<PostList posts={posts} sections={sections} empty="No articles yet." />
		<nav class="row" aria-label="Pagination">
			{cursor && <a class="textlink" href="/posts">First page</a>}
			{nextCursor && <a class="textlink" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
		</nav>
	</section>
</Base>
