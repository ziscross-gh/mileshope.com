---
import { getEmDashEntry, getSeoMeta, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// A title typed into the entry's SEO panel wins; otherwise the page is named
// after its menu label (About), falling back to its own heading.
const hasSeoTitle = Boolean((page as any).seo?.title ?? (page.data as any).seo?.title);
const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	preferNavLabel={!hasSeoTitle}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="wrap section stack" style="gap: var(--space-6)">
		<header class="stack" style="max-width: 760px">
			<h1 {...page.edit.title}>{page.data.title}</h1>
			{page.data.lead && <p class="lead" {...page.edit.lead}>{page.data.lead}</p>}
		</header>
		<div class="prose" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>
