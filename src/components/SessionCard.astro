---
interface Props {
	session: any;
	/** Compact cards on the home page leave out the description and button. */
	compact?: boolean;
}
const { session, compact = false } = Astro.props;
const d = session.data;
---

<div class:list={["card", "session", d.highlight && "is-highlight"]}>
	{d.kicker && <p class="label" {...session.edit.kicker}>{d.kicker}</p>}
	<h3 {...session.edit.title}>{d.title}</h3>
	{d.price && <p class="price" {...session.edit.price}>{d.price}</p>}
	{
		!compact && d.description && (
			<p class="desc" {...session.edit.description}>
				{d.description}
			</p>
		)
	}
	{
		!compact && d.button_label && (
			<a class:list={["btn", d.highlight ? "btn-book" : "btn-earth"]} href="#book">
				{d.button_label}
			</a>
		)
	}
</div>

<style>
	.session {
		flex: 1 1 280px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.desc {
		flex-grow: 1;
	}
	.btn {
		margin-top: var(--space-2);
	}
</style>
